#--------------------------------------------------------------------
# Konfigurasi lokal. Disalin otomatis menjadi .env oleh install.bat / install.sh
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

database.default.hostname = localhost
database.default.database = soundbox_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Akun admin yang dibuat saat seeding (php spark db:seed DatabaseSeeder). Ganti password-nya!
ADMIN_EMAIL = umraithi769@gmail.com
ADMIN_PASSWORD = soundbox123

# Alamat frontend lain yang boleh memanggil /api (pisahkan dengan koma).
# Tidak perlu diisi kalau website dibuka dari server ini (http://localhost:8080).
CORS_ORIGINS = http://localhost:5500,http://127.0.0.1:5500,https://soundbox.kadaferhidup.my.id
